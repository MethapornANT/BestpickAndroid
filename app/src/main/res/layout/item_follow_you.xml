<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notification_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:paddingTop="6dp"
    android:paddingBottom="12dp"
    android:background="@color/white"
    android:foreground="?attr/selectableItemBackground">

<ImageView
android:id="@+id/comment_profile_image"
android:layout_width="56dp"
android:layout_height="56dp"
android:layout_marginStart="6dp"
android:layout_marginEnd="12dp"
android:layout_marginBottom="12dp"
    android:scaleType="centerCrop"
    android:clipToOutline="true"
    android:background="@drawable/rounded_image"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent" />

    <!-- เวลา มุมขวาบน -->
<TextView
android:id="@+id/comment_created_at"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginEnd="12dp"
android:text="13 ส.ค. 2025, 15:37"
android:textSize="12sp"
android:textColor="@android:color/darker_gray"
android:singleLine="true"
android:includeFontPadding="false"
app:layout_constraintTop_toTopOf="parent"
app:layout_constraintEnd_toEndOf="parent" />

    <!-- ชื่อ 1 บรรทัด ตัด ... ก่อนชนเวลา -->
<TextView
android:id="@+id/comment_username"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="0dp"
android:layout_marginEnd="8dp"
android:paddingLeft="10dp"
android:text="AnTz"
android:textStyle="bold"
android:textSize="16sp"
android:textColor="@color/black"
android:singleLine="true"
android:ellipsize="end"
android:includeFontPadding="false"
app:layout_constraintStart_toEndOf="@id/comment_profile_image"
app:layout_constraintEnd_toStartOf="@id/comment_created_at"
app:layout_constraintTop_toTopOf="parent" />

    <!-- barrier เพื่อให้บรรทัดเนื้อหาวางชิดใต้แถวบนเสมอ -->
<androidx.constraintlayout.widget.Barrier
android:id="@+id/top_row_barrier"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
app:barrierDirection="bottom"
app:constraint_referenced_ids="comment_username,comment_created_at" />

    <!-- เนื้อหา ใต้แถวบนเสมอ ไม่ทับเวลา ขยายจนถึงขอบขวา (มี marginEnd) -->
<TextView
android:id="@+id/comment_content"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="0dp"
android:layout_marginEnd="12dp"
android:paddingLeft="10dp"
android:layout_marginTop="6dp"
android:layout_marginBottom="4dp"
android:text="โฆษณาของคุณได้รับการตรวจสอบแล้ว กรุณาโอนเงิน…"
android:textSize="13sp"
android:textStyle="normal"
android:textColor="@color/gray_dark"
android:maxLines="2"
android:ellipsize="end"
android:includeFontPadding="false"
android:lineSpacingExtra="2dp"
android:breakStrategy="balanced"
app:layout_constraintStart_toStartOf="@id/comment_username"
app:layout_constraintEnd_toEndOf="parent"
app:layout_constraintTop_toBottomOf="@id/top_row_barrier"
app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Divider -->
<View
android:layout_width="0dp"
android:layout_height="1dp"
android:background="#E6E6E6"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent"
app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
