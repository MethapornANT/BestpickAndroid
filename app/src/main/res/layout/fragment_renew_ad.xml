<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgwhite1"
    tools:context=".RenewAdFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:layout_gravity="center_vertical|start"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Renew Advertisement"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center"/>
    </androidx.appcompat.widget.Toolbar>

    <ImageView
        android:id="@+id/adImageView"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_margin="16dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:src="@color/grey"/>

    <TextView
        android:id="@+id/adTitleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/adImageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Ad Title"/>

    <TextView
        android:id="@+id/selectPackageLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select a new package"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/adTitleTextView"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"/>

    <RadioGroup
        android:id="@+id/radioGroupPackages"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/selectPackageLabel">

        <RadioButton
            android:id="@+id/radioButtonPackage1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/package_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:text="Starter Package\n7 Day\nFor testing advertising"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:visibility="gone"
            tools:visibility="visible"
            android:button="@null" />

        <RadioButton
            android:id="@+id/radioButtonPackage2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/package_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:text="Popular packages\n15 Day\nBest value! Reach more customers"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:visibility="gone"
            tools:visibility="visible"
            android:button="@null" />

        <RadioButton
            android:id="@+id/radioButtonPackage3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/package_bg"
            android:padding="16dp"
            android:text="Full package\n30 Day\nFor maximum visibility"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:visibility="gone"
            tools:visibility="visible"
            android:button="@null" />

    </RadioGroup>

    <Button
        android:id="@+id/nextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Next"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>