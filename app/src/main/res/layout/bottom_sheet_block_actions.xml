<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    app:cardBackgroundColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bs_action"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/bs_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_warning" />

            <TextView
                android:id="@+id/bs_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="จัดการการสนทนา"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:textColor="@android:color/black"/>

            <TextView
                android:id="@+id/bs_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="เลือกการทำงานที่ต้องการ"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:textColor="#7A7A7A"/>
        </LinearLayout>

        <!-- ปุ่ม Block (Outlined) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="บล็อกการสนทนา"
            android:layout_marginTop="8dp"
            app:icon="@drawable/ic_block"
            app:iconSize="18dp"
            app:iconPadding="10dp"
            app:cornerRadius="18dp"
            app:strokeColor="#DDDDDD"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/white"
            android:textColor="@android:color/black"/>

        <!-- ปุ่ม Unblock (Filled) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnblock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ปลดบล็อกการสนทนา"
            android:layout_marginTop="8dp"
            app:icon="@drawable/ic_unblock"
            app:iconSize="18dp"
            app:iconPadding="10dp"
            app:cornerRadius="18dp"
            app:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"/>

        <!-- ปุ่มยกเลิก (Text) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ยกเลิก"
            android:layout_marginTop="6dp"
            app:backgroundTint="@android:color/transparent"
            android:textColor="#7A7A7A"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
